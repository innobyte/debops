{#
#    ==== nginx geo template for debops.nginx role ====
#
# More information about maps: https://nginx.org/en/docs/http/ngx_http_geo_module.html
# List of parameters supported by this template:
#
#   - item.name: ''
#       Name of the map configuration file. Required.
#
#   - item.geo: ''
#       Describes the dependency of values of the specified variable
#       on the client IP address.
#         '$geo'
#         '$arg_remote_addr $geo'
#
#   - item.default: ''
#       A value set to the variable if the client address does not
#       match any of the specified addresses. (without the semicolon).
#
#   - item.include: []
#       List of files to include in this geo map { } definition (use absolute paths
#       to files).
#
#   - item.proxies: []
#       When a request comes from a trusted address, an address from the
#       "X-Forwarded-For" request header field will be used instead.
#
#   - item.proxy_recursive: ''
#       If recursive search is disabled then instead of the original client address
#       that matches one of the trusted addresses, the last address sent in
#       "X-Forwarded-For" will be used. If recursive search is enabled then instead
#       of the original client address that matches one of the trusted addresses,
#       the last non-trusted address sent in “X-Forwarded-For” will be used.
#
#   - item.ranges: ''
#       Indicates that addresses are specified as ranges
#
#   - item.mapping: |
#       Text block with value mapping specified in the nginx configuration
#       format (semicolons need to be included at the end of each line).
#
#   - item.delete: True
#       If this parameter is defined and True, map configuration file will
#       be removed from the host.
#
#}
# {{ ansible_managed }}

{% if item.name is defined and item.name                                          %}
geo {{ item.map }} {
{%     if item.ranges is defined and item.ranges                                  %}
        ranges;
{%     endif                                                                      %}
{%     if item.proxies is defined and item.proxies                                %}
{%         for proxy in item.proxies                                              %}
        proxy {{ proxy }};
{%         endfor                                                                 %}
{%     endif                                                                      %}
{%     if item.proxy_recursive is defined and item.proxy_recursive                %}
        proxy_recursive;
{%     endif                                                                      %}
{%     if item.default is defined and item.default                                %}
        default {{ item.default }};
{%     endif                                                                      %}
{%     if item.mapping is defined and item.mapping                                %}
        {{ item.mapping | indent(8) | regex_replace("(?m)^\s*$", "") }}
{%     endif                                                                      %}
{%     if item.include is defined and item.include                                %}
{%         for file in item.include                                               %}
        include {{ file }};
{%         endfor                                                                 %}
{%     endif                                                                      %}
}
{% endif                                                                          %}

